# Copy to .env and fill in your own values:  cp .env.example .env
# Generate a secret key with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
# Comma-separated hostnames allowed to serve the app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,transcoder.example.com
# Comma-separated origins for CSRF when behind a reverse proxy
DJANGO_CSRF_ORIGINS=https://transcoder.example.com

# First admin account, created at startup if it does not exist
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

TZ=Europe/Paris
